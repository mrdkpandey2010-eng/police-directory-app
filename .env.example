# Google Firebase Cloud Live Chat Configuration
# (वैकल्पिक: आप इसे सीधे ऐप के भीतर "क्लाउड सेटअप" बटन से भी 1-क्लिक में पेस्ट कर सकते हैं)

VITE_FIREBASE_API_KEY=AIzaSyExampleKey123456789
VITE_FIREBASE_AUTH_DOMAIN=police-directory-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=police-directory-app
VITE_FIREBASE_STORAGE_BUCKET=police-directory-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
